{
  "name": "agi-times-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run content:config-validate && npm run content:validate && npm run content:editorial-validate && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply agi-times-v2 --local",
    "db:migrate:remote": "wrangler d1 migrations apply agi-times-v2 --remote",
    "content:config-validate": "node scripts/validate-ingestion-sources.mjs",
    "content:build": "node scripts/build-content-registry.mjs && node scripts/generate-seed-content.mjs && node scripts/generate-daily-insight.mjs",
    "content:ingest": "node scripts/ingest-current-sources.mjs",
    "content:ingest:expanded": "node scripts/ingest-expanded-sources.mjs",
    "content:classify": "node scripts/classify-ingested-candidates.mjs",
    "source-health:fetch:local": "node scripts/fetch-source-health.mjs",
    "source-health:fetch:remote": "node scripts/fetch-source-health.mjs --remote",
    "source-health:sync:local": "node scripts/sync-source-health.mjs",
    "source-health:sync:remote": "node scripts/sync-source-health.mjs --remote",
    "content:generate-current": "node scripts/generate-current-content.mjs",
    "content:verify-incremental": "node scripts/verify-incremental-publication.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "content:editorial-validate": "node scripts/validate-editorial-content.mjs",
    "content:links": "node scripts/validate-editorial-content.mjs --network",
    "insight:daily-check": "node scripts/check-daily-insight.mjs",
    "content:sync:local": "node scripts/sync-content.mjs",
    "content:sync:remote": "node scripts/sync-content.mjs --remote"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@posthog/react": "1.10.3",
    "hono": "4.13.1",
    "lucide-react": "1.31.0",
    "posthog-js": "1.415.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260810.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "ipaddr.js": "^2.2.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
