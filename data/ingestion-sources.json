        },
        {
          "id": "new-rising",
          "q": "topic:artificial-intelligence created:>={windowStart} stars:>=10",
          "sort": "stars",
          "order": "desc",
          "per_page": 100
        }
      ],
      "trendMetrics": [
        "stargazers_count",
        "forks_count",
        "pushed_at",
        "created_at"
      ],
      "eligibility": {
        "fork": false,
        "archived": false,
        "disabled": false,
        "minimumStars": 25,
        "requireLicenseForNewRising": true,
        "maximumDaysSincePush": 14,
        "requireAgIRelevanceReview": true
      },
      "ranking": {
        "activeEstablished": "log1p(stars)*0.45 + log1p(forks)*0.15 + pushFreshness*0.25 + starDelta*0.15",
